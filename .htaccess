Options -MultiViews
RewriteEngine On

# ------------------------------------------------------------------
# GAIA TOURS & TRAVEL — Multilingual URL Routing
# ------------------------------------------------------------------
# URL language prefixes: /en/ (English, LTR) and /ar/ (Arabic, RTL)
#
#   /en/                    -> index.php?lang=en
#   /ar/                    -> index.php?lang=ar
#   /en/tours               -> weroad/search.php?lang=en
#   /ar/tours               -> weroad/search.php?lang=ar
#   /en/tours/jordan-360    -> weroad/trip.php?lang=en&slug=jordan-360
#   /en/gaia-night          -> gaia-night.php?lang=en
#
# Non-prefixed URLs keep working (defaults to English).

# --- Homepage ---
RewriteRule ^(en|ar)/?$ index.php?lang=$1 [QSA,L]

# --- Tours ---
RewriteRule ^(en|ar)/tours/?$ weroad/search.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/tours/([^/]+)/?$ tour.php?lang=$1&slug=$2 [QSA,L]

# --- Dynamic detail pages: Events / Hotels / Rooms ---
RewriteRule ^(en|ar)/events/([^/]+)/?$ events.php?lang=$1&slug=$2 [QSA,L]
RewriteRule ^(en|ar)/hotels/([^/]+)/?$ hotel.php?lang=$1&slug=$2 [QSA,L]
RewriteRule ^(en|ar)/rooms/([0-9]+)/?$ room.php?lang=$1&id=$2 [QSA,L]

# --- Non-prefixed clean routes (defaults to English) ---
RewriteRule ^tours/?$ weroad/search.php [QSA,L]
RewriteRule ^tours/([^/]+)/?$ tour.php?slug=$1 [QSA,L]
RewriteRule ^events/([^/]+)/?$ events.php?slug=$1 [QSA,L]
RewriteRule ^hotels/([^/]+)/?$ hotel.php?slug=$1 [QSA,L]
RewriteRule ^rooms/([0-9]+)/?$ room.php?id=$1 [QSA,L]
RewriteRule ^destinations/?$ weroad/search.php?destinations=1 [QSA,L]
RewriteRule ^gaia-night/?$ gaia-night.php [QSA,L]
RewriteRule ^checkout/?$ checkout.php [QSA,L]
RewriteRule ^transfer-booking/?$ transfer-booking.php [QSA,L]
RewriteRule ^transfers?/?$ transfer-booking.php [QSA,L]
RewriteRule ^transportation/?$ transfer-booking.php [QSA,L]
RewriteRule ^route/?$ route.php [QSA,L]
RewriteRule ^(about|contact|terms-and-conditions|privacy-policy|refund-policy)/?$ page.php?slug=$1 [QSA,L]
RewriteRule ^reviews/?$ index.php [QSA,L]
RewriteRule ^hotels/?$ search-hotels.php [QSA,L]
RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+) [NC]
RewriteRule ^events/?$ events.php [QSA,L]
RewriteRule ^events/?$ gaia-night.php [QSA,L]

# --- Destinations ---
RewriteRule ^(en|ar)/destinations/?$ weroad/search.php?lang=$1&destinations=1 [QSA,L]

# --- Hotels ---
RewriteRule ^(en|ar)/hotels/?$ search-hotels.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/search-hotels/?$ search-hotels.php?lang=$1 [QSA,L]
RewriteRule ^search-hotels/?$ search-hotels.php [QSA,L]

# --- Transfers / transfer booking / Transportation ---
RewriteRule ^(en|ar)/transfers?/?$ transfer-booking.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/transfer-booking/?$ transfer-booking.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/transportation/?$ transfer-booking.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/route/?$ route.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/checkout/?$ checkout.php?lang=$1 [QSA,L]

# --- GAIA Night / Events / Reviews ---
RewriteRule ^(en|ar)/gaia-night/?$ gaia-night.php?lang=$1 [QSA,L]
RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+) [NC]
RewriteRule ^(en|ar)/events/?$ events.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/events/?$ gaia-night.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/reviews/?$ index.php?lang=$1 [QSA,L]

# --- Partner Application ---
RewriteRule ^(en|ar)/partner/apply(\.php)?/?$ partner/apply.php?lang=$1 [QSA,L]
RewriteRule ^partner/apply(\.php)?/?$ partner/apply.php [QSA,L]

# --- About / Contact / Policies (CMS pages from `pages` table) ---
RewriteRule ^(en|ar)/(about|contact|terms-and-conditions|privacy-policy|refund-policy)/?$ page.php?lang=$1&slug=$2 [QSA,L]

# --- Authentication & Account (language-prefixed) ---
RewriteRule ^(en|ar)/login/?$ login.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/register/?$ register.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/forgot-password/?$ forgot-password.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/reset-password/?$ reset-password.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/logout/?$ logout.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/?$ account/index.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/dashboard/?$ account/index.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/bookings/?$ account/bookings.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/payments/?$ account/payments.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/invoices/?$ account/invoices.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/profile/?$ account/profile.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/security/?$ account/security.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/my-bookings/?$ account/my-bookings.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/claim-booking/?$ account/claim-booking.php?lang=$1 [QSA,L]
RewriteRule ^(en|ar)/account/(bookings|booking)/([A-Za-z0-9\-]+)/?$ account/booking.php?lang=$1&reference=$2 [QSA,L]

# --- Authentication & Account (clean, defaults to English) ---
RewriteRule ^login/?$ login.php [QSA,L]
RewriteRule ^register/?$ register.php [QSA,L]
RewriteRule ^forgot-password/?$ forgot-password.php [QSA,L]
RewriteRule ^reset-password/?$ reset-password.php [QSA,L]
RewriteRule ^logout/?$ logout.php [QSA,L]
RewriteRule ^account/dashboard/?$ account/index.php [QSA,L]
RewriteRule ^account/(bookings|payments|invoices|security)/?$ account/$1.php [QSA,L]
RewriteRule ^account/(bookings|booking)/([A-Za-z0-9\-]+)/?$ account/booking.php?reference=$2 [QSA,L]
RewriteRule ^account/(profile|my-bookings|claim-booking)/?$ account/$1.php [QSA,L]
RewriteRule ^account/?$ account/index.php [QSA,L]

# --- Generic fallback: keep any existing file working with a lang prefix ---
RewriteRule ^(en|ar)/(.*)$ $2?lang=$1 [QSA,L]
